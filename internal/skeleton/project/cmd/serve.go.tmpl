var serveCmd = &cobra.Command{
	Use:   "serve",
	Short: "Start the HTTP server",
	Long:  "Start the {{.ProjectNameLower}} HTTP server{{if .GraphQL}} with GraphQL and{{end}} REST endpoints.",
	RunE: func(cmd *cobra.Command, args []string) error {
		return startServer()
	},
}

func init() {
	rootCmd.AddCommand(serveCmd)
}

func startServer() error {
	container, err := di.InitializeServiceContainer()
	if err != nil {
		return err
	}
	di.WireSetterDependencies(container)

	cfg := container.Config
	logger := container.Logger

	// Fail fast if security-critical secrets are still empty or set to the
	// gofasta library's development placeholder — never serve traffic with a
	// publicly-known JWT/session signing key.
	if err := cfg.ValidateSecrets(); err != nil {
		return fmt.Errorf("refusing to start: %w", err)
	}

	// Hand the DB to devtools so /debug/explain can issue EXPLAIN
	// queries against captured SQL. No-op in production.
	devtools.RegisterDB(container.DB)

	// Initialize tracing (if enabled)
	if cfg.Observability.TracingEnabled {
		shutdown := observability.InitTracer(cfg.Observability.ServiceName)
		defer shutdown()
		// Devtools trace capture — hooks into the global tracer provider
		// so every span also lands in the in-memory ring the dashboard
		// scrapes. No-op in production builds (no `devtools` build tag).
		devtools.RegisterTraceProcessor()
	}

	// Start WebSocket hub
	go container.WebSocketHub.Run()

{{- if .GraphQL}}
	graphqlHandler := buildGraphQLHandler(container)
{{- end}}

	// Build REST router
	// The driver-aware constructor makes /health/ready catch the
	// degraded-fallback case: the in-memory SQLite stub ProvideDB
	// substitutes when the real DB is unreachable reports driver
	// "sqlite", which mismatches the configured driver and turns
	// readiness into 503 — so a load balancer or `gofasta deploy`'s
	// health gate (deploy.health_path: /health/ready) never routes
	// traffic to a half-alive instance.
	healthController := health.NewControllerForDriver(container.DB, container.CacheService, cfg.Database.Driver)
	apiRouter := routes.InitAPIRoutes(&routes.RouteConfig{
		UserController: container.UserController,
		// gofasta:scaffold:routeconfig-init — `gofasta g scaffold` inserts new <Name>Controller: container.<Name>Controller, lines above this. Don't remove the marker.
		HealthController: healthController,
		WebSocketHub:     container.WebSocketHub,
	})

	mux := http.NewServeMux()
{{- if .GraphQL}}
	// The playground is config-gated (dev-true in config.yaml,
	// env-false in the production compose manifest) — it's a schema
	// browser and query console that has no place on a public API.
	if cfg.GraphQL.PlaygroundEnabled {
		mux.Handle(cfg.GraphQL.PlaygroundRoute, playground.Handler("GraphQL playground", cfg.GraphQL.GeneralRoute))
	}
	mux.Handle(cfg.GraphQL.GeneralRoute, graphqlHandler)
{{- end}}

	mux.Handle("/", apiRouter)

	// Prometheus metrics endpoint
	if cfg.Observability.MetricsEnabled {
		mux.Handle(cfg.Observability.MetricsPath, observability.MetricsHandler())
	}

	// Devtools debug endpoints — /debug/requests, /debug/sql,
	// /debug/health. Active only when the binary is built with the
	// `devtools` build tag (set by `gofasta dev` via GOFLAGS). In
	// production builds the handler responds {"devtools":"stub"} to
	// /debug/health and 404 to everything else.
	mux.Handle("/debug/", devtools.Handler())

	// Build middleware chain
	rootHandler := middleware.Chain(mux, buildMiddlewareChain(container)...)

	// Bind to cfg.Server.Host:Port. The default host (set in pkg/config) is
	// 127.0.0.1, which keeps macOS's firewall quiet during local Air rebuilds —
	// the OS only prompts for permission on non-loopback listeners. Production
	// containers and VPS deploys override this via env var (e.g.
	// {{.ProjectNameUpper}}_SERVER_HOST=0.0.0.0); the scaffold's Dockerfile and
	// compose manifests do this already.
	srv := &http.Server{
		Addr:    cfg.Server.Host + ":" + cfg.Server.Port,
		Handler: rootHandler,
	}

	// Start cron job scheduler
	sched := startScheduler(container, logger)

	// Start async task queue (if enabled)
	if container.QueueService != nil {
		go func() {
			if err := container.QueueService.Start(); err != nil {
				slog.Error("queue server error", "error", err)
			}
		}()
	}

	// Graceful shutdown
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	go func() {
		slog.Info("server starting", "host", cfg.Server.Host, "port", cfg.Server.Port)
		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			slog.Error("server error", "error", err)
			os.Exit(1)
		}
	}()

	<-ctx.Done()
	slog.Info("shutting down gracefully")

	sched.Stop()

	if container.QueueService != nil {
		container.QueueService.Shutdown()
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), cfg.Server.ShutdownTimeout)
	defer cancel()

	if err := srv.Shutdown(shutdownCtx); err != nil {
		slog.Error("server forced to shutdown", "error", err)
	}

	if sqlDB, err := container.DB.DB(); err == nil {
		if err := sqlDB.Close(); err != nil {
			slog.Error("closing database connection", "error", err)
		}
	}

	slog.Info("server stopped")
	return nil
}

{{- if .GraphQL}}
// buildGraphQLHandler builds the GraphQL server with an explicit,
// config-gated posture instead of handler.NewDefaultServer.
// NewDefaultServer ships introspection unconditionally on and no
// complexity limit — fine for a playground, wrong as a production
// default. Each transport is declared explicitly; gqlgen's GET
// transport refuses mutations per the GraphQL-over-HTTP spec, so
// enabling it is safe.
func buildGraphQLHandler(container *di.ServiceContainer) *handler.Server {
	cfg := container.Config
	srv := handler.New(app.NewExecutableSchema(app.Config{
		Resolvers: container.Resolver,
	}))
	srv.AddTransport(transport.Options{})
	srv.AddTransport(transport.GET{})
	srv.AddTransport(transport.POST{})
	srv.AddTransport(transport.MultipartForm{})
	srv.SetQueryCache(lru.New[*ast.QueryDocument](1000))
	srv.Use(extension.AutomaticPersistedQuery{Cache: lru.New[string](100)})
	if cfg.GraphQL.IntrospectionEnabled {
		srv.Use(extension.Introspection{})
	}
	if cfg.GraphQL.ComplexityLimit > 0 {
		srv.Use(extension.FixedComplexityLimit(cfg.GraphQL.ComplexityLimit))
	}
	srv.SetErrorPresenter(apperrors.GraphQLErrorPresenter)
	return srv
}
{{- end}}

// buildMiddlewareChain assembles the HTTP middleware stack in the order it
// should run: request identity and logging outermost, then panic recovery,
// then the security-relevant headers, then the optional feature middlewares.
//
// Split out of startServer so the three optional-feature toggles live here
// rather than adding branches to an already long startup function. Add new
// conditional middleware here, not inline in startServer.
func buildMiddlewareChain(container *di.ServiceContainer) []middleware.Middleware {
	cfg := container.Config
	logger := container.Logger

	middlewares := []middleware.Middleware{
		middleware.RequestID(),
		middleware.RequestLogging(logger),
		// Devtools Recovery wraps the gofasta library's Recovery: in devtools
		// builds it captures the panic + stack + request into the
		// exceptions ring (surfaced on the dashboard); in production
		// it delegates straight to pkg/middleware.Recovery so behavior
		// is unchanged.
		middleware.Middleware(devtools.Recovery(middleware.Recovery(logger))),
		middleware.CORS(cfg.Server.AllowedOrigins),
		middleware.SecurityHeaders(cfg.Security),
		// Devtools request-capture — pass-through no-op in production builds.
		middleware.Middleware(devtools.Middleware),
	}
	if cfg.RateLimit.Enabled {
		middlewares = append(middlewares, middleware.RateLimit(cfg.RateLimit))
	}
	if cfg.Observability.MetricsEnabled {
		middlewares = append(middlewares, middleware.Middleware(observability.MetricsMiddleware))
	}
	if cfg.Observability.TracingEnabled {
		middlewares = append(middlewares, middleware.Middleware(observability.TracingMiddleware(cfg.Observability.ServiceName)))
	}
	return middlewares
}

func startScheduler(container *di.ServiceContainer, logger *slog.Logger) *scheduler.Scheduler {
	sched := scheduler.New(logger)
	registry := map[string]scheduler.Job{
		"example": jobs.NewExampleJob(logger),
	}
	for _, jobCfg := range container.Config.Jobs {
		if !jobCfg.Enabled {
			continue
		}
		job, ok := registry[jobCfg.Name]
		if !ok {
			slog.Warn("unknown job in config, skipping", "job", jobCfg.Name)
			continue
		}
		if err := sched.Register(jobCfg.Schedule, job); err != nil {
			slog.Error("failed to register job", "job", jobCfg.Name, "error", err)
		}
	}
	sched.Start()
	return sched
}
