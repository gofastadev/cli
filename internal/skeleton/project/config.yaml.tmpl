project:
  # Layout chosen at scaffold time. Read by `gofasta g *` and
  # `gofasta refactor` to know whether to emit files into layered
  # directories (app/models/, app/services/, …) or per-feature
  # directories (app/<resource>/). Don't change this by hand — use
  # `gofasta refactor feature-package` to migrate an existing project
  # between layouts.
  layout: {{.Layout}}

server:
  # Bind address. The default 127.0.0.1 keeps the dev server on loopback,
  # which on macOS skips the firewall popup that would otherwise fire on
  # every Air rebuild. For Docker / production set host to 0.0.0.0 — the
  # scaffold's Dockerfile and compose manifests do this via env var
  # ({{.ProjectNameUpper}}_SERVER_HOST=0.0.0.0), so you usually don't
  # need to change it here.
  host: "127.0.0.1"
  port: "8080"
  shutdown_timeout: 15s
  # Origins allowed to make browser (CORS) requests. Do NOT use "*" in
  # production — list your real frontend origin(s) here, or override via
  # {{.ProjectNameUpper}}_SERVER_ALLOWED_ORIGINS. Defaults to localhost for
  # local development only.
  allowed_origins:
    - "http://localhost:3000"
    - "http://localhost:8080"

database:
  driver: {{.DBDriver}}
{{- if eq .DBDriver "sqlite" }}
  # SQLite is a file-based driver — no host/port/credentials.
  # The `name` value below is the on-disk path to the database file.
  name: {{.ProjectNameLower}}.db
{{- else if eq .DBDriver "mysql" }}
  host: localhost
  port: "3306"
  name: {{.ProjectNameLower}}_dev
  user: {{.ProjectNameLower}}
  password: {{.ProjectNameLower}}
  max_idle: 10
  max_open: 100
  max_life: 1h
{{- else if eq .DBDriver "sqlserver" }}
  host: localhost
  port: "1433"
  name: {{.ProjectNameLower}}_dev
  user: sa
  password: YourStrong@Passw0rd
  max_idle: 10
  max_open: 100
  max_life: 1h
{{- else if eq .DBDriver "clickhouse" }}
  host: localhost
  port: "9000"
  name: {{.ProjectNameLower}}_dev
  user: default
  password: ""
  max_idle: 10
  max_open: 100
  max_life: 1h
{{- else }}
  host: localhost
  port: "5432"
  name: {{.ProjectNameLower}}_dev
  user: {{.ProjectNameLower}}
  password: {{.ProjectNameLower}}
  sslmode: disable
  max_idle: 10
  max_open: 100
  max_life: 1h
{{- end }}
  # When the database is unreachable at boot: false (default) refuses to
  # start — in production a half-alive process hides the outage; a crash
  # loop makes it visible. true boots on an in-memory SQLite stub with
  # DB-touching endpoints returning 5xx. `gofasta dev` sets the
  # {{.ProjectNameUpper}}_DATABASE_DEGRADED_FALLBACK env override for its
  # child when you pick "Run app without db", so local dev keeps that
  # workflow either way.
  degraded_fallback: false

{{- if .GraphQL}}
graphql:
  playground_route: /graphql-playground
  general_route: /graphql
  # Dev-friendly defaults, disabled for production via env overrides in
  # deployments/docker/compose.production.yaml. Introspection and the
  # playground expose the full schema; the complexity limit caps
  # adversarial deeply-nested queries.
  playground_enabled: true
  introspection_enabled: true
  complexity_limit: 200
{{- end}}

log:
  level: info
  format: text

email:
  provider: smtp        # smtp, sendgrid, or brevo
  from_name: {{.ProjectName}} App
  from_address: noreply@example.com
  smtp:
    host: localhost
    port: 587
    use_tls: true
  # sendgrid:
  #   api_key: SG.your-api-key
  # brevo:
  #   api_key: xkeysib-your-api-key

auth:
  # Intentionally empty here: config.yaml is committed to version control,
  # so it must never carry a signing key. The real value lives in .env
  # (gitignored) as {{.ProjectNameUpper}}_AUTH_JWT_SECRET — `gofasta new`
  # generated a random one there. The app refuses to boot while this
  # resolves to empty or a known placeholder.
  jwt_secret: ""
  access_token_expiry: 15m
  refresh_token_expiry: 168h
  rbac_model: configs/rbac_model.conf
  rbac_policy: configs/rbac_policy.csv

rate_limit:
  # On by default: a public API with no rate limit is one curl loop away
  # from a resource-exhaustion outage. 100 req/s per client is generous
  # for development; tune the rate rather than switching this off.
  enabled: true
  rate: "100-S"           # 100 requests per second
  store: memory           # memory or redis

cache:
  driver: memory          # memory or redis
  # redis:
  #   host: localhost
  #   port: "6379"
  #   password: ""
  #   db: 0

security:
  hsts: true
  hsts_max_age: 31536000
  frame_deny: true
  content_type_nosniff: true
  browser_xss_filter: true
  referrer_policy: "strict-origin-when-cross-origin"

storage:
  driver: local           # local or s3
  local:
    path: ./uploads
  # s3:
  #   endpoint: s3.amazonaws.com
  #   bucket: my-bucket
  #   access_key: ""
  #   secret_key: ""
  #   region: us-east-1
  #   use_ssl: true

queue:
  enabled: false
  concurrency: 10
  queues:
    default: 1
  # redis:
  #   host: localhost
  #   port: "6379"
  #   password: ""
  #   db: 1

websocket:
  enabled: true

i18n:
  default_language: en
  locales_dir: locales

feature_flag:
  # Master switch consumed by `pkg/featureflag`. When false the service is a
  # no-op and every flag resolves to its caller-supplied default. When true
  # the service evaluates through whichever OpenFeature provider the app
  # registered at startup (in-memory, Flagd, LaunchDarkly, go-feature-flag,
  # etc.). See `configs/features.yaml` for notes.
  enabled: false
  config_path: configs/features.yaml

encryption:
  key: ""                 # Set a 32-byte key to enable (e.g. "12345678901234567890123456789012")

session:
  driver: cookie          # cookie or filesystem
  # Intentionally empty here: config.yaml is committed to version control,
  # so it must never carry a signing key. The real value lives in .env
  # (gitignored) as {{.ProjectNameUpper}}_SESSION_SECRET — `gofasta new`
  # generated a random one there. The app refuses to boot while this
  # resolves to empty or a known placeholder.
  secret: ""
  session_name: {{.ProjectNameLower}}_session
  # filesystem_path: ./sessions
  # Session cookie attributes. cookie_secure stays false here so plain-
  # HTTP local development works; the production compose manifest sets
  # {{.ProjectNameUpper}}_SESSION_COOKIE_SECURE=true. cookie_same_site
  # accepts lax|strict|none (none requires cookie_secure: true).
  cookie_secure: false
  cookie_http_only: true
  cookie_same_site: lax
  cookie_max_age: 2592000  # seconds (30 days)

observability:
  metrics_enabled: true
  tracing_enabled: false
  metrics_path: /metrics
  service_name: {{.ProjectNameLower}}

jobs:
  - name: example
    schedule: "0 0 */6 * * *"
    enabled: false

# ── Deployment ──
deploy:
  host: ""              # user@server.com (required for gofasta deploy)
  method: docker        # docker or binary
  port: 22              # SSH port
  path: ""              # remote directory (default: /opt/{{.ProjectNameLower}})
  arch: amd64           # target architecture: amd64 or arm64
  # /health/ready (not /health) so the deploy gate checks REAL readiness:
  # it verifies DB + cache connectivity and that the live DB driver
  # matches config (catching a degraded-fallback boot). Plain /health
  # answers 200 as soon as the process is up, even with a dead database.
  health_path: /health/ready
  health_timeout: 30    # seconds to wait for health check
  keep_releases: 3      # number of old releases to keep for rollback
