package resolvers

// GraphQL input → domain filter conversion.
//
// Lives here rather than in app/dtos for two reasons:
//
//   - The GraphQL input types are generated by gqlgen and only exist in
//     projects scaffolded with --graphql. app/dtos is compiled in every
//     project, so a method on UserFiltersDto there would not compile for a
//     REST-only build. Everything under app/graphql/ is skipped for REST-only
//     projects, so this file is naturally conditional.
//
//   - It must not be a *.resolvers.go file: gqlgen owns those and relocates
//     any non-resolver declaration into a commented-out block. See
//     gql_errors.go for the full explanation.
//
// The REST counterpart is TUserFiltersQueryParamsDto.ToFilter() in
// app/dtos/user.dtos.go. The two inputs have deliberately different SHAPES —
// REST is flat query params, GraphQL is a nested input object — but they must
// produce the same defaults, or an unfiltered list would paginate differently
// depending on which transport the client used. Keep them in step.

import (
	"github.com/gofastadev/gofasta/pkg/types"

	"{{.ModulePath}}/app/dtos"
	"{{.ModulePath}}/app/services"
)

// Defaults applied when the client omits pagination or sorting. These mirror
// TUserFiltersQueryParamsDto.ToFilter() exactly.
const (
	defaultFilterPage      = 1
	defaultFilterLimit     = 10
	defaultFilterSortField = "created_at"
	defaultFilterSortDesc  = true
)

// userFiltersToFilter translates the nested GraphQL filter input into the
// typed domain filter the service expects, applying the shared defaults for
// anything the client left out.
func userFiltersToFilter(in dtos.UserFiltersDto) services.ListUsersFilter {
	f := services.ListUsersFilter{
		Page:      defaultFilterPage,
		Limit:     defaultFilterLimit,
		SortField: defaultFilterSortField,
		SortDesc:  defaultFilterSortDesc,
	}

	if in.Fields != nil {
		f.FirstName = in.Fields.FirstName
		f.OtherNames = in.Fields.OtherNames
		f.Email = in.Fields.Email
		f.PhoneNumber = in.Fields.PhoneNumber
	}

	if in.Pagination != nil {
		if in.Pagination.Page != nil && *in.Pagination.Page > 0 {
			f.Page = *in.Pagination.Page
		}
		if in.Pagination.Limit != nil && *in.Pagination.Limit > 0 {
			f.Limit = *in.Pagination.Limit
		}
	}

	if in.Sorting != nil {
		// SortByField is a plain string, so an omitted field and an explicit
		// empty string are indistinguishable here. Both mean "not specified":
		// an empty ORDER BY column would make pagination non-deterministic.
		if in.Sorting.SortByField != "" {
			f.SortField = in.Sorting.SortByField
		}
		if in.Sorting.SortOrientation != nil && in.Sorting.SortOrientation.IsValid() {
			f.SortDesc = *in.Sorting.SortOrientation == types.SortOrientationDesc
		}
	}

	return f
}
