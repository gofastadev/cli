# .github/workflows/test.yml
# Copy this file to .github/workflows/test.yml
#
# Runs the project's full preflight on every push and PR. The preflight
# target (in the project's Makefile) chains: gofmt check, go vet,
# golangci-lint with the pinned version, race tests, and a build —
# mirroring gofasta's own development workflow so a green local
# preflight predicts a green CI run.
#
# The pinned golangci-lint version below MUST match GOLANGCI_LINT_VERSION
# in the Makefile. Bump them together when upgrading.

name: Test

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  preflight:
    runs-on: ubuntu-latest
{{- if eq .DBDriver "postgres" }}

    # The DB service and its connection env mirror deployments/docker/
    # compose.yaml so CI talks to the same engine the app is configured for.
    services:
      postgres:
        image: postgres:18-alpine
        env:
          POSTGRES_USER: {{.ProjectNameLower}}
          POSTGRES_PASSWORD: {{.ProjectNameLower}}
          POSTGRES_DB: {{.ProjectNameLower}}_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U {{.ProjectNameLower}} -d {{.ProjectNameLower}}_test"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5

    env:
      {{.ProjectNameUpper}}_DATABASE_HOST: localhost
      {{.ProjectNameUpper}}_DATABASE_PORT: "5432"
      {{.ProjectNameUpper}}_DATABASE_USER: {{.ProjectNameLower}}
      {{.ProjectNameUpper}}_DATABASE_PASSWORD: {{.ProjectNameLower}}
      {{.ProjectNameUpper}}_DATABASE_NAME: {{.ProjectNameLower}}_test
      {{.ProjectNameUpper}}_DATABASE_SSLMODE: disable
{{- else if eq .DBDriver "mysql" }}

    services:
      mysql:
        image: mysql:8.4
        env:
          MYSQL_ROOT_PASSWORD: {{.ProjectNameLower}}
          MYSQL_USER: {{.ProjectNameLower}}
          MYSQL_PASSWORD: {{.ProjectNameLower}}
          MYSQL_DATABASE: {{.ProjectNameLower}}_test
        ports:
          - 3306:3306
        options: >-
          --health-cmd "mysqladmin ping -h 127.0.0.1 -u{{.ProjectNameLower}} -p{{.ProjectNameLower}}"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10

    env:
      {{.ProjectNameUpper}}_DATABASE_HOST: 127.0.0.1
      {{.ProjectNameUpper}}_DATABASE_PORT: "3306"
      {{.ProjectNameUpper}}_DATABASE_USER: {{.ProjectNameLower}}
      {{.ProjectNameUpper}}_DATABASE_PASSWORD: {{.ProjectNameLower}}
      {{.ProjectNameUpper}}_DATABASE_NAME: {{.ProjectNameLower}}_test
{{- else if eq .DBDriver "sqlserver" }}

    services:
      sqlserver:
        image: mcr.microsoft.com/mssql/server:2022-latest
        env:
          ACCEPT_EULA: "Y"
          MSSQL_SA_PASSWORD: "YourStrong@Passw0rd"
          MSSQL_PID: Developer
        ports:
          - 1433:1433
        options: >-
          --health-cmd "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P YourStrong@Passw0rd -No -Q 'SELECT 1'"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 20

    env:
      {{.ProjectNameUpper}}_DATABASE_HOST: localhost
      {{.ProjectNameUpper}}_DATABASE_PORT: "1433"
      {{.ProjectNameUpper}}_DATABASE_USER: sa
      {{.ProjectNameUpper}}_DATABASE_PASSWORD: "YourStrong@Passw0rd"
      {{.ProjectNameUpper}}_DATABASE_NAME: {{.ProjectNameLower}}_test
{{- else if eq .DBDriver "clickhouse" }}

    services:
      clickhouse:
        image: clickhouse/clickhouse-server:24.8-alpine
        env:
          CLICKHOUSE_DB: {{.ProjectNameLower}}_test
          CLICKHOUSE_USER: {{.ProjectNameLower}}
          CLICKHOUSE_PASSWORD: {{.ProjectNameLower}}
          CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: "1"
        ports:
          - 9000:9000
          - 8123:8123
        options: >-
          --health-cmd "wget --no-verbose --tries=1 --spider http://localhost:8123/ping || exit 1"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 20

    env:
      {{.ProjectNameUpper}}_DATABASE_HOST: localhost
      {{.ProjectNameUpper}}_DATABASE_PORT: "9000"
      {{.ProjectNameUpper}}_DATABASE_USER: {{.ProjectNameLower}}
      {{.ProjectNameUpper}}_DATABASE_PASSWORD: {{.ProjectNameLower}}
      {{.ProjectNameUpper}}_DATABASE_NAME: {{.ProjectNameLower}}_test
{{- else if eq .DBDriver "sqlite" }}

    # sqlite is file-based — no service container. The app writes a local
    # .db file for the duration of the run.
    env:
      {{.ProjectNameUpper}}_DATABASE_DRIVER: sqlite
      {{.ProjectNameUpper}}_DATABASE_NAME: {{.ProjectNameLower}}_test.db
{{- end }}

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: "1.25"
{{- if eq .DBDriver "mysql" }}

      # The scaffold's per-resource migrations install BEFORE UPDATE /
      # BEFORE DELETE triggers through the app's DB user. GitHub Actions
      # service containers can't pass --log_bin_trust_function_creators as
      # a startup flag (compose.yaml sets it via `command:`), so enable it
      # at runtime as root before migrations run. The mysql client ships
      # with the ubuntu-latest runner image.
      - name: Allow MySQL trigger creation
        run: mysql -h 127.0.0.1 -P 3306 -uroot -p{{.ProjectNameLower}} -e "SET GLOBAL log_bin_trust_function_creators = 1;"
{{- end }}

      - name: Install dependencies
        run: go mod download

      # Install the linter at the version the Makefile pins, so CI and a
      # developer's `make preflight` agree on the ruleset.
      - name: Install golangci-lint
        uses: golangci/golangci-lint-action@v8
        with:
          version: v2.11.4
          install-mode: binary
          args: --version

      - name: Preflight
        run: make preflight

      # Re-run the suite via `gofasta test --coverage` so a per-package
      # coverage profile lands as coverage.out. Distinct from `make
      # preflight`'s plain `go test -race ./...` because --coverage
      # adds `-coverpkg=./...` — required in projects with `tool`
      # directives in go.mod (wire/gqlgen/swag/air all qualify) to
      # avoid the per-package "go: no such tool covdata" warning.
      #
      # gofasta CLI is not in the project's go.mod tool list (only
      # wire/air/swag/gqlgen are — gofasta is a developer tool, not a
      # build-time dependency), so the runner installs it inline.
      - name: Install gofasta CLI
        run: go install github.com/gofastadev/cli/cmd/gofasta@latest

      - name: Test with coverage
        run: gofasta test --coverage

      - name: Upload coverage to codecov
        uses: codecov/codecov-action@v5
        if: success()
        with:
          files: ./coverage.out
          fail_ci_if_error: false
