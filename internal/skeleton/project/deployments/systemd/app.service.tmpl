# {{.ProjectName}} Systemd Service
# For bare-metal VPS deployment (no Docker), managed by `gofasta deploy`.
#
# `gofasta deploy setup` installs prerequisites and creates the layout;
# `gofasta deploy --method binary` then installs this unit and manages
# releases under /opt/{{.ProjectNameLower}}:
#
#   /opt/{{.ProjectNameLower}}/releases/<timestamp>/   one directory per release
#   /opt/{{.ProjectNameLower}}/shared/.env             production secrets (create this once)
#   /opt/{{.ProjectNameLower}}/current                 symlink to the live release
#
# The unit runs from `current`, so config.yaml, migrations/, and templates/
# always resolve inside the active release.
#
# Logs: journalctl -u {{.ProjectNameLower}} -f

[Unit]
Description={{.ProjectName}} Application Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.ProjectNameLower}}
Group={{.ProjectNameLower}}
WorkingDirectory=/opt/{{.ProjectNameLower}}/current
# "-" prefix: don't fail the unit when shared/.env doesn't exist (a
# config.yaml-only project is valid); secrets normally live there.
EnvironmentFile=-/opt/{{.ProjectNameLower}}/shared/.env
# The gofasta library's default Server.Host is 127.0.0.1 (loopback) — chosen so
# macOS doesn't prompt the firewall on every Air rebuild during local
# development. On a production VPS the app must listen on all interfaces
# (or at least the address nginx upstreams to), so override here.
Environment="{{.ProjectNameUpper}}_SERVER_HOST=0.0.0.0"
ExecStart=/usr/local/bin/{{.ProjectNameLower}} serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/{{.ProjectNameLower}}
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
